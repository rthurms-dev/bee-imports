function Card({p,open}){return html`<article className="card bg-[#141414] border border-white/10 cut group">
<button className="block w-full text-left" onClick=${()=>open(p)} aria-label=${"Ver "+p.n}>
<div className="aspect-square overflow-hidden grid-bg bg-gradient-to-br from-[#141414] to-[#222] relative">${p.img?html`<img src=${p.img} alt=${p.n} loading="lazy" className="w-full h-full object-cover"/>`:html`<div className="absolute inset-0 p-10"><${Art} cat=${p.cat}/></div>`}${p.novo?html`<span className="absolute top-3 right-3 text-[11px] tracking-widest border border-white/40 px-2 py-1">LANÇAMENTO</span>`:null}</div>
<div className="p-5 space-y-2"><${Badge}/><h3 className="text-lg font-bold leading-tight">${p.n}</h3>
<p className="text-2xl font-semibold">${money(p.price)}</p><p className="text-sm text-[#888]">${parc(p.price)} sem juros</p>
<p className="text-xs text-[#888]">Tamanhos: ${p.sizes.join(" · ")}</p></div></button></article>`}

function Quick({p,close,add}){const [s,setS]=useState(p.sizes[0]);
return html`<div className="fixed inset-0 z-[70] bg-black/80 flex items-center justify-center p-4" onClick=${close}>
<div role="dialog" aria-modal="true" className="bg-[#141414] border border-white/15 max-w-3xl w-full grid md:grid-cols-2 cut max-h-[92vh] overflow-auto" onClick=${e=>e.stopPropagation()}>
<div className="grid-bg bg-[#1b1b1b] p-10 flex items-center min-h-[220px]"><${Art} cat=${p.cat}/></div>
<div className="p-6 space-y-4"><div className="flex justify-between items-start"><${Badge}/><button onClick=${close} aria-label="Fechar"><${Ic} n="x"/></button></div>
<h3 className="text-3xl font-bold">${p.n}</h3><p className="text-[#bbb]">${p.d}</p>
<p className="text-3xl font-semibold">${money(p.price)}</p><p className="text-sm text-[#888]">${parc(p.price)} sem juros</p>
<div><p className="text-sm mb-2 text-[#888]">Tamanho</p><div className="flex gap-2 flex-wrap">${p.sizes.map(z=>html`<button key=${z} onClick=${()=>setS(z)} aria-pressed=${s===z} className=${"min-w-[48px] px-4 py-3 border "+(s===z?"text-white":"border-white/25 text-[#ddd]")} style=${s===z?{background:RED,borderColor:RED}:{}}>${z}</button>`)}</div></div>
<${Frete}/><button onClick=${()=>{add(p,s);close()}} className="w-full py-4 font-bold tracking-widest text-white cut hover:brightness-110 transition" style=${{background:RED}}>ADICIONAR AO CARRINHO</button></div></div></div>`}

function Cart({items,set,close}){
const [ship,setShip]=useState(null);
const sub=items.reduce((a,i)=>a+i.p.price*i.q,0),total=sub+(ship?ship.price:0);
const msg=()=>{const l=items.map(i=>`• ${i.q}x ${i.p.n} (Tam. ${i.s}) – ${money(i.p.price*i.q)}`).join("\n");
return "https://wa.me/"+WHATS+"?text="+encodeURIComponent("Olá, Bee Imports! Quero fazer este pedido:\n\n"+l+(ship?"\n\nFrete "+ship.name+" (CEP "+ship.cep+"): "+money(ship.price):"")+"\n\nTotal: "+money(total)+"\n\nPode confirmar disponibilidade e formas de pagamento?")};
const chg=(k,d)=>set(items.map(i=>i.k===k?{...i,q:i.q+d}:i).filter(i=>i.q>0));
return html`<div className="fixed inset-0 z-[80]"><div className="absolute inset-0 bg-black/70" onClick=${close}></div>
<aside className="absolute right-0 top-0 h-full w-full max-w-md bg-[#0F0F0F] border-l border-white/15 flex flex-col" style=${{paddingTop:"env(safe-area-inset-top,0px)",paddingBottom:"env(safe-area-inset-bottom,0px)"}}>
<div className="flex items-center justify-between p-5 border-b border-white/10"><h2 className="text-xl font-bold tracking-widest">SEU CARRINHO</h2><button onClick=${close} aria-label="Fechar carrinho"><${Ic} n="x"/></button></div>
<div className="flex-1 overflow-auto p-5 space-y-4">${items.length===0?html`<p className="text-[#888]">Seu carrinho está vazio.</p>`:items.map(i=>html`<div key=${i.k} className="flex gap-4 border border-white/10 p-3 bg-[#141414]">
<div className="w-20 h-20 grid-bg bg-[#1b1b1b] p-2 shrink-0"><${Art} cat=${i.p.cat}/></div>
<div className="flex-1 min-w-0"><p className="font-semibold leading-tight">${i.p.n}</p><p className="text-sm text-[#888]">Tam. ${i.s} · ${money(i.p.price)}</p>
<div className="flex items-center gap-3 mt-2"><button className="border border-white/25 p-1" onClick=${()=>chg(i.k,-1)} aria-label="Diminuir"><${Ic} n="minus" s=${16}/></button><span>${i.q}</span><button className="border border-white/25 p-1" onClick=${()=>chg(i.k,1)} aria-label="Aumentar"><${Ic} n="plus" s=${16}/></button>
<button className="ml-auto text-sm text-[#888] underline" onClick=${()=>set(items.filter(x=>x.k!==i.k))}>Remover</button></div></div></div>`)}${items.length?html`<${Frete} onPick=${setShip}/>`:null}</div>
<div className="p-5 border-t border-white/10 space-y-3"><div className="flex justify-between text-sm text-[#aaa]"><span>Subtotal</span><span>${money(sub)}</span></div>${ship?html`<div className="flex justify-between text-sm text-[#aaa]"><span>Frete ${ship.name}</span><span>${money(ship.price)}</span></div>`:null}<div className="flex justify-between text-lg"><span>Total</span><b>${money(total)}</b></div>
<a href=${items.length?msg():"#"} target="_blank" rel="noopener" aria-disabled=${!items.length} className=${"block text-center py-4 font-bold tracking-widest text-white cut "+(items.length?"":"opacity-40 pointer-events-none")} style=${{background:RED}}>FINALIZAR PEDIDO PELO WHATSAPP</a></div></aside></div>`}

function Frete({onPick}){const [cep,setCep]=useState(""),[res,setRes]=useState(null),[sel,setSel]=useState(null);
const mask=v=>{const d=v.replace(/\D/g,"").slice(0,8);return d.length>5?d.slice(0,5)+"-"+d.slice(5):d};
const calc=()=>{setSel(null);onPick&&onPick(null);const d=cep.replace(/\D/g,"");if(d.length!==8){setRes("err");return}
const b=Math.min(4,Math.floor(+d[0]/2));setRes([{id:"pac",name:"PAC",price:+(21.9+b*6.4).toFixed(2),a:4+b*2},{id:"sedex",name:"SEDEX",price:+(38.9+b*11.5).toFixed(2),a:1+b}].map(o=>({...o,cep})))};
return html`<div className="border border-white/10 bg-[#101010] p-4 space-y-3"><p className="text-sm tracking-widest text-[#bbb]">CALCULAR FRETE</p>
<div className="flex gap-2"><input value=${cep} onChange=${e=>setCep(mask(e.target.value))} onKeyDown=${e=>e.key==="Enter"&&calc()} inputMode="numeric" placeholder="00000-000" aria-label="CEP" className="flex-1 min-w-0 bg-[#141414] border border-white/20 px-3 py-2 outline-none focus:border-white/60"/><button onClick=${calc} className="px-4 py-2 text-sm font-semibold border border-white/40 hover:bg-white hover:text-black transition">Calcular</button></div>
<div aria-live="polite" className="space-y-2">${res==="err"?html`<p className="text-sm" style=${{color:RED}}>Digite um CEP válido com 8 números.</p>`:null}
${Array.isArray(res)?res.map(o=>html`<button key=${o.id} disabled=${!onPick} onClick=${()=>{setSel(o.id);onPick&&onPick(o)}} className=${"w-full flex justify-between items-center text-left px-3 py-2 border text-sm "+(sel===o.id?"border-white bg-white/10":"border-white/15")}><span><b>${o.name}</b><span className="block text-xs text-[#888]">${o.a} a ${o.a+2} dias úteis</span></span><b>${money(o.price)}</b></button>`):null}
${Array.isArray(res)?html`<p className="text-xs text-[#777]">Simulação. O valor final é confirmado no atendimento.</p>`:null}</div></div>`}

function Story({h,close,go}){useEffect(()=>{const f=e=>e.key==="Escape"&&close();window.addEventListener("keydown",f);return()=>window.removeEventListener("keydown",f)},[]);
return html`<div className="fixed inset-0 z-[75] bg-black/85 flex items-center justify-center p-4" onClick=${close}>
<div role="dialog" aria-modal="true" aria-label=${h.t} className="pop w-full max-w-sm bg-[#101010] border border-white/15 cut max-h-[90vh] overflow-auto" onClick=${e=>e.stopPropagation()}>
<div className="h-1 mx-4 mt-4" style=${{background:"linear-gradient(90deg,"+GOLD+","+RED+")"}}></div>
<div className="flex items-center gap-3 p-4"><img src=${LOGO} alt="" className="w-9 h-9 rounded-full object-cover"/><div className="flex-1"><p className="text-sm font-semibold">_beeimports</p><p className="text-xs text-[#888]">${h.t}</p></div><button onClick=${close} aria-label="Fechar"><${Ic} n="x"/></button></div>
<div className="px-6 pb-6 space-y-4"><h3 className="text-2xl font-bold" style=${{color:GOLD}}>${h.title}</h3>
${h.items?h.items.map(t=>html`<p key=${t} className="text-[#ddd] border-l-2 pl-3 border-white/20">${t}</p>`):P.filter(p=>p.novo).map(p=>html`<button key=${p.id} onClick=${()=>{close();go({g:"todos",c:"todas",n:1})}} className="w-full flex justify-between border border-white/15 px-3 py-3 text-left hover:border-white/50"><span>${p.n}</span><b>${money(p.price)}</b></button>`)}
<a href=${IG} target="_blank" rel="noopener" className="block text-center py-3 text-sm font-bold tracking-widest border border-white/40 hover:bg-white hover:text-black transition">VER NO INSTAGRAM</a></div></div></div>`}

const Profile=({openStory})=>html`<section className="max-w-7xl mx-auto px-4 pt-12" aria-label="Instagram @_beeimports"><div className="border border-white/10 bg-[#101010] cut p-6 sm:p-8">
<div className="flex flex-col sm:flex-row sm:items-center gap-6">
<div className="ring-ig shrink-0 w-28 h-28 sm:w-32 sm:h-32 rounded-full p-[3px]"><img src=${LOGO} alt="Bee Imports, perfil oficial" className="w-full h-full rounded-full object-cover border-4 border-[#101010]"/></div>
<div className="flex-1 min-w-0"><div className="flex flex-wrap items-center gap-2"><h2 className="text-2xl font-bold">@_beeimports</h2><span className="inline-flex items-center gap-1 text-[11px] font-semibold tracking-widest px-2 py-1 text-black" style=${{background:GOLD}}><${Ic} n="check" s=${12}/>ORIGINAL</span></div>
<div className="mt-3 flex gap-6 text-sm">${[[POSTS,"posts"],[FOLLOWERS,"seguidores"],[CLIENTS,"clientes"]].map(([n,l])=>html`<p key=${l}><b className="text-lg">${n}</b><span className="block text-[#888]">${l}</span></p>`)}</div>
<p className="mt-3 text-sm text-[#bbb] flex items-center gap-2"><span style=${{color:GOLD}}><${Ic} n="truck" s=${18}/></span>Envios para todo o Brasil</p></div>
<a href=${IG} target="_blank" rel="noopener" className="text-center px-6 py-3 font-bold tracking-widest text-sm text-black cut hover:brightness-110 transition" style=${{background:GOLD}}>SEGUIR NO INSTAGRAM</a></div>
<div className="mt-8 flex gap-6 overflow-x-auto pb-2" role="group" aria-label="Destaques">${HL.map(h=>html`<button key=${h.k} onClick=${()=>openStory(h)} className="shrink-0 w-24 text-center group" aria-label=${"Abrir destaque "+h.t}>
<span className="ring-ig block w-[76px] h-[76px] mx-auto rounded-full p-[3px]"><span className="w-full h-full rounded-full bg-[#0A0A0A] border-[3px] border-[#101010] flex items-center justify-center text-white"><${Ic} n=${h.ic} s=${26}/></span></span>
<span className="block mt-2 text-xs text-[#ccc] leading-tight">${h.t}</span></button>`)}</div></div></section>`

const Feed=()=>html`<section className="max-w-7xl mx-auto px-4 pb-20" aria-label="Feed do Instagram"><div className="flex flex-wrap items-end justify-between gap-3 mb-6"><h2 className="text-3xl sm:text-4xl font-bold">DIRETO DO NOSSO FEED</h2><a href=${IG} target="_blank" rel="noopener" className="text-sm tracking-widest hover:underline" style=${{color:GOLD}}>@_BEEIMPORTS →</a></div>
<div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-1.5">${FEED.map(([c,l,t],i)=>html`<a key=${i} href=${IG} target="_blank" rel="noopener" aria-label=${"Ver post no Instagram: "+t} className="group relative block aspect-square overflow-hidden bg-[#141414] border border-white/10 card">
<div className="absolute inset-0 grid-bg p-8"><${Art} cat=${c}/></div>
<div className="absolute inset-0 bg-black/85 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition flex flex-col items-center justify-center text-center p-3 gap-2"><span className="flex items-center gap-1 font-semibold" style=${{color:GOLD}}><${Ic} n="heart" s=${16}/>${l}</span><span className="text-[11px] leading-snug text-[#ddd]">${t}</span><span className="text-[10px] tracking-widest border border-white/50 px-2 py-1">VER POST NO INSTAGRAM</span></div></a>`)}</div></section>`

function Float(){const [o,setO]=useState(false);const c="pop flex items-center gap-2 bg-[#141414] border border-white/20 px-4 py-2 text-sm shadow-lg hover:border-white/60";
return html`<div className="fixed right-4 z-40 flex flex-col items-end gap-2" style=${{bottom:"calc(1rem + env(safe-area-inset-bottom,0px))"}}>
${o?html`<a href=${"https://wa.me/"+WHATS} target="_blank" rel="noopener" className=${c}><${Ic} n="chat" s=${16}/>WhatsApp</a><a href=${IG} target="_blank" rel="noopener" className=${c}><${Ic} n="ig" s=${16}/>Instagram</a>`:null}
<button onClick=${()=>setO(!o)} aria-expanded=${o} aria-label="Atendimento rápido" className="w-12 h-12 rounded-full bg-[#141414] border border-white/25 shadow-lg grid place-items-center hover:border-white/70 transition"><${Ic} n=${o?"x":"chat"}/></button></div>`}

function App(){
const [g,setG]=useState("todos"),[cat,setCat]=useState("todas"),[q,setQ]=useState(""),[news,setNews]=useState(false),[sort,setSort]=useState("rel"),[story,setStory]=useState(null);
