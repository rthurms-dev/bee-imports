.card:hover img{transform:scale(1.06)}
select{color-scheme:dark}
@media(prefers-reduced-motion:reduce){.skull{animation:none}html{scroll-behavior:auto}}
@keyframes pop{from{transform:translateY(12px);opacity:0}to{transform:none;opacity:1}}.pop{animation:pop .25s ease-out}
