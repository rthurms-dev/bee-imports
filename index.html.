// TROCAR: números, curtidas e depoimentos abaixo são EXEMPLOS — substitua pelos reais
const FOLLOWERS="12,4 mil",POSTS="480",CLIENTS="1,2 mil+";
const HL=[
{k:"fb",t:"Feedbacks",ic:"star",title:"Clientes satisfeitos",items:["“Chegou rápido e tudo original, com nota fiscal. Recomendo!” — Rafael, SP","“Juliet impecável, embalagem top.” — Camila, MG","“Atendimento show, tirou todas as minhas dúvidas.” — Lucas, PR"]},
{k:"env",t:"Envios & Correios",ic:"truck",title:"Envio para todo o Brasil",items:["Envio via PAC ou SEDEX, com código de rastreio.","Embalagem reforçada para proteger a sua peça.","Simule o frete pelo seu CEP direto no carrinho."]},
{k:"orig",t:"100% Original",ic:"shield",title:"Autenticidade garantida",items:["Nota fiscal em todos os produtos.","Etiquetas e embalagens originais Oakley.","Veja cada detalhe nas fotos reais do nosso Instagram."]},
{k:"new",t:"Novidades da Semana",ic:"spark",title:"Acabou de chegar",items:null}];
const FEED=[["oculos","1.248","Juliet no pulso, estilo no rosto. 🕶️"],["sueteres","936","Frio chegando, corta-vento na mala."],["camisas","812","Drop novo, peça original de verdade."],["oculos","1.530","Prizm: o mundo em alto contraste."],["bermudas","705","Verão pede boardshort. 🌊"],["calcas","688","Cargo tech: conforto com atitude."]];
const RED="#FF2A00";
const money=v=>v.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const CATS=[["oculos","Óculos"],["camisas","Camisas & Camisetas"],["bermudas","Bermudas"],["calcas","Calças"],["sueteres","Suéteres & Blusas de Frio"]];
const ROUPA=["P","M","G","GG"],UN=["Único"];
const P=[
{id:1,n:"Juliet X-Metal",cat:"oculos",g:"m",price:1890,sizes:UN,d:"Armação em X-Metal com lentes Polarized. Ícone da Oakley."},
{id:2,n:"Penny Prizm Rose",cat:"oculos",g:"f",price:1190,sizes:UN,d:"Silhueta feminina com lentes Prizm que realçam o contraste."},
{id:3,n:"Radar EV Path",cat:"oculos",g:"mf",price:1290,sizes:UN,d:"Visão ampliada para esporte e dia a dia, encaixe firme."},
{id:4,n:"Sutro Matte Black",cat:"oculos",g:"m",price:990,sizes:UN,d:"Design envolvente com acabamento preto fosco."},
{id:5,n:"Frogskins Clear",cat:"oculos",g:"mf",price:790,sizes:UN,d:"Clássico urbano com armação translúcida."},
{id:6,n:"Camiseta Bark Heritage",cat:"camisas",g:"m",price:229,sizes:ROUPA,d:"Algodão macio com estampa Oakley no peito.",novo:1},
{id:7,n:"Camiseta Enduro Feminina",cat:"camisas",g:"f",price:199,sizes:ROUPA,d:"Tecido leve de secagem rápida para treino."},
{id:8,n:"Boardshort 19” Oakley",cat:"bermudas",g:"m",price:329,sizes:ROUPA,d:"Bermuda de praia com cós firme e secagem rápida."},
{id:9,n:"Cargo Short Tech",cat:"bermudas",g:"m",price:389,sizes:ROUPA,d:"Bolsos cargo funcionais e tecido resistente.",novo:1},
{id:10,n:"Calça Cargo Tech",cat:"calcas",g:"m",price:549,sizes:ROUPA,d:"Corte reto, tecido técnico e bolsos laterais."},
{id:11,n:"Calça Moletom Fleece",cat:"calcas",g:"f",price:359,sizes:ROUPA,d:"Moletom felpudo e confortável, visual urbano."},
{id:12,n:"Corta-vento Packable",cat:"sueteres",g:"mf",price:649,sizes:ROUPA,d:"Leve, dobrável e resistente ao vento.",novo:1},
{id:13,n:"Moletom Canguru B1B",cat:"sueteres",g:"mf",price:489,sizes:ROUPA,d:"Capuz ajustável e bolso canguru."}
];
const ART={oculos:"M25 55h70v18a14 14 0 0 1-14 14H39a14 14 0 0 1-14-14zM105 55h70v18a14 14 0 0 1-14 14h-42a14 14 0 0 1-14-14zM95 62h10",camisas:"M70 25l-40 18 10 25 15-6v55h90V62l15 6 10-25-40-18a30 20 0 0 1-60 0z",bermudas:"M55 30h90l8 80h-38l-15-45-15 45H47z",calcas:"M60 20h80l6 105h-34l-12-70-12 70H54z",sueteres:"M70 22l-45 20 8 70 22-6v14h90v-14l22 6 8-70-45-20a30 22 0 0 1-60 0zM100 40v90"};
const Art=({cat})=>html`<svg className="art w-full h-full" viewBox="0 0 200 140" fill="none" stroke=${RED} strokeWidth="3" strokeLinejoin="round" role="img" aria-label="Ilustração do produto"><path d=${ART[cat]}/></svg>`;
const I={search:"M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.3-4.3",cart:"M6 6h15l-2 9H8zM6 6L5 3H2M9 20h.01M18 20h.01",menu:"M4 6h16M4 12h16M4 18h16",x:"M6 6l12 12M18 6L6 18",plus:"M12 5v14M5 12h14",minus:"M5 12h14",shield:"M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z",truck:"M3 6h11v10H3zM14 9h4l3 3v4h-7M7 19h.01M17 19h.01",chat:"M4 5h16v11H9l-5 4z",check:"M5 12l5 5L20 7",star:"M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z",spark:"M12 3v5M12 16v5M3 12h5M16 12h5",heart:"M12 20s-7-4.5-7-10a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 5.5-7 10-7 10z",ig:"M4 4h16v16H4zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM17 7h.01"};
const Ic=({n,s=22})=>html`<svg width=${s} height=${s} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d=${I[n]}/></svg>`;
